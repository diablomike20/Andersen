{
  "name": "Andersen",
  "short_name": "Andersen",
  "description": "Magyar nyelvű novella- és regényíró műhely mesterséges intelligencia támogatással.",
  "start_url": "/WorldScript-Studio/?source=pwa",
  "scope": "/WorldScript-Studio/",
  "id": "/WorldScript-Studio/",

  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",

  "background_color": "#020617",
  "theme_color": "#020617",

  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Sablonok",
      "short_name": "Sablonok",
      "description": "Történetsablonok böngészése és új projekt indítása",
      "url": "/WorldScript-Studio/?view=templates&source=shortcut",
      "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Kéziratom",
      "short_name": "Kézirat",
      "description": "A kézirat megnyitása",
      "url": "/WorldScript-Studio/?view=manuscript&source=shortcut",
      "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Karakterek",
      "short_name": "Karakterek",
      "description": "Karakterek kezelése",
      "url": "/WorldScript-Studio/?view=characters&source=shortcut",
      "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "MI-író",
      "short_name": "Író",
      "description": "Az MI-íróstúdió megnyitása",
      "url": "/WorldScript-Studio/?view=writer&source=shortcut",
      "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Új jelenet",
      "short_name": "Jelenet",
      "description": "Ugrás a cselekménytáblára és új jelenet hozzáadása",
      "url": "/WorldScript-Studio/#/board?action=add-scene",
      "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Írási munkamenet indítása",
      "short_name": "Munkamenet",
      "description": "Az íráskövető megnyitása és írási munkamenet indítása",
      "url": "/WorldScript-Studio/#/progress?action=start-session",
      "icons": [{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],

  "launch_handler": {
    "client_mode": "navigate-existing"
  },

  "handle_links": "preferred",

  "share_target": {
    "action": "/WorldScript-Studio/",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },

  "protocol_handlers": [
    {
      "protocol": "web+worldscript",
      "url": "/WorldScript-Studio/?protocol=%s"
    }
  ],

  "edge_side_panel": {
    "preferred_width": 480
  },

  "categories": ["productivity", "utilities", "entertainment", "education"],
  "lang": "hu",
  "dir": "ltr",
  "prefer_related_applications": false,
  "iarc_rating_id": ""
}
